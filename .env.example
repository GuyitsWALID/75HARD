# Created by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment

# Browser client (from the Convex dashboard)
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Set these on the Convex deployment, not in this file:
#   npx convex env set BETTER_AUTH_SECRET <random-secret>
#   npx convex env set SITE_URL http://localhost:5173
# Production:
#   npx convex env set --prod BETTER_AUTH_SECRET <random-secret>
#   npx convex env set --prod SITE_URL https://your-app.vercel.app
